rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@demob.com' ||
        request.auth.token.email == 'esaalberdi@gmail.com' ||
        request.auth.token.email == 'lemaitremariejoe@gmail.com' ||
        request.auth.token.email == 'pretsodatabase@gmail.com' ||
        request.auth.token.email == 'mrwally@snack.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin'
      );
    }

    function isAdmin() {
      return isSuperAdmin() || (isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    
    // For DemoMJ, allow authenticated users (including anonymous and PIN users) full read/write access
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
